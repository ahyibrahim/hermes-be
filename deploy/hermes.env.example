# Environment for one hermes-be instance.
#
# Installed by scripts/setup-host.sh as /etc/hermes/<instance>.env and read by
# the systemd template unit as EnvironmentFile=/etc/hermes/%i.env. The values
# below are the ones for the `p1` instance; for a second instance replace every
# p1 with that instance name and give it a different PORT.
#
# systemd parses this file itself, not through a shell: no `export`, no command
# substitution, and quotes are only needed for values containing spaces.
#
# Restart the service after editing:  sudo systemctl restart hermes-be@p1

# Port the Fastify server binds, on 0.0.0.0.
PORT=3000

# SQLite database file. Created on first start if absent, and migrated in place
# on every start. Must live under the instance's ReadWritePaths.
HERMES_DB_PATH=/var/lib/hermes/p1/hermes.db

# Directory for uploaded files. Created on first start if absent.
HERMES_FILES_DIR=/var/lib/hermes/p1/files

# How long a login token stays valid, in days. Optional; defaults to 30.
# Sessions live in the database now, so this is the real logout interval --
# restarting the service no longer signs anyone out.
HERMES_SESSION_TTL_DAYS=30

# Commit currently deployed, reported by GET /health so a deploy can be
# verified. scripts/deploy.sh rewrites this line on every deploy; there is no
# need to set it by hand. Without it /health falls back to asking git, and then
# to reporting "unknown".
HERMES_GIT_COMMIT=

# Static web bundle directory, arriving in v0.4.0. Left commented out because
# the @fastify/static mount does not exist yet and an unset value is a no-op.
#HERMES_WEB_DIR=/var/lib/hermes/p1/web
